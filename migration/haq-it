#! /bin/bash

set -x

# Parse options
export BATCH_MODE=false
while [[ "$1" == --* ]]; do
  case "$1" in
    --batch) BATCH_MODE=true; shift ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

