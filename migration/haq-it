#! /bin/bash

set -ex

# Parse options
export BATCH_MODE=false
while [[ "$1" == --* ]]; do
  case "$1" in
    --batch) BATCH_MODE=true; shift ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# TODO this only works in a new shell, do a source?
# TODO or just the mvn commands
# or a pre-script?
# curl -Ls https://sh.jbang.dev | bash -s - trust add https://repo1.maven.org/maven2/io/quarkiverse/roq/
# curl -Ls https://sh.jbang.dev | bash -s - app install --fresh --force roq@quarkiverse/quarkus-roq

export project_dir=$1
export tools_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export tmp_dir=~/tmp

(
cd ${project_dir}

# Fetch latest from all remotes before resetting
git fetch origin
git fetch upstream

# Reset to upstream/main
git reset --hard upstream/main

# Remove untracked files and directories
git clean -fd
rm -rf target/
rm -rf _site/

# Cherry-pick unmerged branch commits to validate conversion handles real changes.
# Skipped: roq-conversion (is the conversion itself), branches already in upstream/main,
# and duplicate commits across branches.

# --- add-external-link-checking chain (must be in order, all touch LinkCrawlerTest.java) ---

# Add scheduled CI job to check external links and raise defects
git cherry-pick c4abc2ef1b || git cherry-pick --abort

# Tune external link checker: treat 403 as OK for medium.com, add example URLs
git cherry-pick c9b6585113 || git cherry-pick --abort

# Add linkedin/pexels to DO_NOT_CHECK, infoq.com 405 handling
git cherry-pick 6420f4542b || git cherry-pick --abort

# Fix up from bad merge
git cherry-pick ed064fdce7 || git cherry-pick --abort

# --- CI infrastructure (all touch build.yml, order matters) ---


# CI: make site output directory configurable (ci-flexible-site-dir)
git cherry-pick 121c20fbf7 || git cherry-pick --abort

# CI: make site statics directory configurable (ci-flexible-statics-dir)
git cherry-pick eaafef317b2155c53fb35943d987af4a1dc54d32 || git cherry-pick --abort
# CI: make site assets directory configurable (ci-flexible-statics-dir)
git cherry-pick 029beddd2e3d63c315540c10ff7398ea8b688b71 || git cherry-pick --abort
git cherry-pick f3e489ba412ab9e5a4ff70eb89aebabd9cdedb2a || git cherry-pick --abort
git cherry-pick 9e5210b0dc0845d0c6ca56b844a722e35791c1a6 || git cherry-pick --abort
git cherry-pick f1a3f96ef235d6956be6b45861b81a8fd930e700 || git cherry-pick --abort

# CI: allow build to continue if Java tests fail (ci-continue-on-test-failure)
git cherry-pick 4433e5d095 || git cherry-pick --abort

# --- Cleanup branches (independent of each other) ---

# Drop stale data-search-api-server attribute referencing undefined search.url
git cherry-pick aa625cc2a6 || git cherry-pick --abort

# --- Playwright test branches (independent of each other) ---

# Add fragment anchor validation test (test/fragment-anchor-validation)
git cherry-pick 020721c917 || git cherry-pick --abort

# Tighten security page test to require a version number before .x
git cherry-pick 8f13d48a9e || git cherry-pick --abort

# Add tests for guide admonition icons and qs-guide web component registration (test-guide-icons)
git cherry-pick 128d3fd20e || git cherry-pick --abort
git cherry-pick d9efd3dba3 || git cherry-pick --abort
git cherry-pick 30ffadb637 || git cherry-pick --abort

# Add test for duplicate guide titles (test-guide-duplicate-title)
git cherry-pick c283acf76d || git cherry-pick --abort

)


# TODO need to handle qute stuff
## Hack: delete files with Qute example code that the Qute parser would interpret as real template syntax
rm ${project_dir}/_posts/2020-02-24-qute.adoc
rm ${project_dir}/_posts/2022-06-21-qute-templates-from-db.adoc
rm ${project_dir}/_posts/2023-10-10-intellij-quarkus-recap.adoc
rm ${project_dir}/_posts/2025-12-15-quarkus-feature-flags.asciidoc

# Delete qute-reference guides — they document the {| |} escape syntax itself,
# which prematurely closes the escaped-pages {| wrapper.
find ${project_dir}/_guides ${project_dir}/_versions -name "qute-reference.adoc" -delete 2>/dev/null || true

# Delete AsciiDoc posts containing ifdef/ifndef directives — the Roq header parser
# (AsciidocHeaderParser, Yupiik-based) crashes on these even with the JRuby plugin.
# Needs PR #1003, can remove this once it's done
find ${project_dir}/_posts -type f \
    \( -name "*.adoc" -o -name "*.asciidoc" \) \
    -exec grep -l 'ifdef::\|ifndef::' {} \; -delete 2>/dev/null || true

# Delete YAML data files from _versions — they're not content pages and cause
# slug collisions across version directories.
find "${project_dir}/_versions" \( -name "*.yaml" -o -name "*.yml" \) -delete 2>/dev/null || true

# Extensions layouts reference a cdi:extensions bean from deleted YAML data
rm -f ${project_dir}/_layouts/extensions.html ${project_dir}/_layouts/extensions_old.html

# Delete Jekyll includes too complex for auto-conversion (allejo/jekyll-toc: pure-Liquid
# TOC generator using capture-concatenation, continue, slice, times, minus, etc.)
rm -f ${project_dir}/_includes/templates/toc.html

# Delete plugins that are already handled by the converter (filters/config) or need
# manual migration (asciidoctor extensions). Keep only cname.rb and copy-search-wc.rb.
rm -f ${project_dir}/_plugins/asciidoctor-extension.rb
rm -f ${project_dir}/_plugins/regex_filter.rb
rm -f ${project_dir}/_plugins/strings.rb

${tools_dir}/roq-it-jekyll ${project_dir}

# Add e2e profile to pom.xml (excludes e2e-tagged tests by default, profile enables them)
sed -i '' '/<artifactId>maven-surefire-plugin<\/artifactId>/{
N
N
s|<configuration>|<configuration>\
                    <excludedGroups>e2e</excludedGroups>|
}' ${project_dir}/pom.xml

sed -i '' '/<profiles>/a\
\        <profile>\
\            <id>e2e</id>\
\            <build>\
\                <plugins>\
\                    <plugin>\
\                        <artifactId>maven-surefire-plugin</artifactId>\
\                        <configuration>\
\                            <groups>e2e</groups>\
\                            <excludedGroups combine.self="override"/>\
\                        </configuration>\
\                    </plugin>\
\                </plugins>\
\            </build>\
\        </profile>
' ${project_dir}/pom.xml


if [ "${BATCH_MODE}" = "true" ]; then
    # SSG build: render all pages like CI does (quarkus:run with BATCH=true)
    # This catches errors that dev mode misses since it renders every route.
    echo "=== SSG build (quarkus:run) ==="
    (cd ${project_dir} && QUARKUS_ROQ_GENERATOR_BATCH=true mvn -B package quarkus:run -DskipTests \
        > ${tmp_dir}/roq-ssg.log 2>&1) || true
    SSG_ERRORS=$(grep -c 'ERROR' ${tmp_dir}/roq-ssg.log 2>/dev/null || echo 0)
    echo "SSG build complete — ${SSG_ERRORS} error lines (see ${tmp_dir}/roq-ssg.log)"
    grep 'ERROR' ${tmp_dir}/roq-ssg.log | head -10

    # Install Playwright browsers
    (cd ${project_dir} && mvn exec:java -e -Dexec.classpathScope=test \
        -Dexec.mainClass=com.microsoft.playwright.CLI \
        -Dexec.args="install --with-deps chromium")

    # Kill anything already on port 8090 — be emphatic to avoid stale servers
    # from prior runs returning cached error pages
    lsof -ti:8090 | xargs kill -9 2>/dev/null || true
    sleep 2
    lsof -ti:8090 | xargs kill -9 2>/dev/null || true
    sleep 1

    # Start dev server in background on port 8090
    (cd ${project_dir} && mvn quarkus:dev -Dquarkus.http.port=8090 \
        > ${tmp_dir}/roq-server.log 2>&1) &
    SERVER_PID=$!
    # Wait for the server to respond (200 or 500 — both mean it's up)
    timeout 300 bash -c 'until curl -s -o /dev/null -w "%{http_code}" http://localhost:8090 2>/dev/null | grep -qE "200|500"; do sleep 2; done'
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8090 2>/dev/null)
    echo "Dev server started (PID $SERVER_PID, HTTP $HTTP_CODE)"
    if [ "$HTTP_CODE" = "500" ]; then
        echo "ERROR: Server returned 500 — Qute template error detected"
        curl -s http://localhost:8090 | grep -oP 'Parser error[^<]*|Found \d+ Qute problems' | head -5
    fi

    # Run tests against the dev server
    # Use a separate Maven invocation with -pl to avoid stomping the dev server's target/
    (cd ${project_dir} && mvn -B surefire:test -Dtest.url=http://localhost:8090) || true

    kill $SERVER_PID 2>/dev/null
    wait $SERVER_PID 2>/dev/null
fi
