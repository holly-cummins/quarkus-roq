#! /bin/bash

set -ex

# Cross-platform sed in-place edit
# macOS requires 'sed -i ""' while Linux uses 'sed -i'
sed_inplace() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "$@"
    else
        sed -i "$@"
    fi
}

# Parse options
export LIVE_MODE=false
export RESET_MODE=false
export RUN_TESTS=false
export COMMIT_MODE=false
export PUSH_MODE=false
while [[ "$1" == --* ]]; do
  case "$1" in
    --live) LIVE_MODE=true; shift ;;
    --reset) RESET_MODE=true; shift ;;
    --run-tests) RUN_TESTS=true; shift ;;
    --commit) COMMIT_MODE=true; shift ;;
    --push) PUSH_MODE=true; COMMIT_MODE=true; shift ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# TODO this only works in a new shell, do a source?
# TODO or just the mvn commands
# or a pre-script?
# curl -Ls https://sh.jbang.dev | bash -s - trust add https://repo1.maven.org/maven2/io/quarkiverse/roq/
# curl -Ls https://sh.jbang.dev | bash -s - app install --fresh --force roq@quarkiverse/quarkus-roq

export project_dir=$1
export tools_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export tmp_dir=~/tmp

if [ "$RESET_MODE" = "true" ]; then
(
  cd ${project_dir}

  # Fetch latest from all remotes before resetting
  git fetch origin
  git fetch upstream
  git remote add holly https://github.com/holly-cummins/quarkusio.github.io 2>/dev/null || true
  git fetch holly

  # Reset to upstream/main
  git reset --hard upstream/main

  # Remove untracked files and directories
  git clean -fd
  rm -rf target/
  rm -rf _site/

  # Cherry-pick unmerged branch commits to validate conversion handles real changes.
  # Merged PRs (now in upstream/main): ci-flexible-site-dir (#2740),
  # data-search-api-server cleanup, security-test (#2787), guide-icons (#2800),
  # duplicate-title (#2803), strings-filter (#2812), asciidoc-extensions (#2808),
  # regex-filter (#2809).

  # --- CI infrastructure ---


  # Fix site size reduction for Roq output paths (fix/build-reduce-size-roq-paths)
  # find searched $STATICS_DIR (public/) but rm used $SITE_DIR/public/... — wrong path.
  # Fix: search $SITE_DIR directly so paths are correct for both Jekyll and Roq.
  git cherry-pick 890c38d55c || git cherry-pick --abort || true
  git cherry-pick 16984b092d24519f54ac888bc3a7574d3a915d64 || git cherry-pick --abort || true


  # Activate only-latest-guides profile for Roq CI builds (fix/build-roq-profile)
  # Equivalent of Jekyll's --config _config.yml,_only_latest_guides_config.yml
  git cherry-pick b7eb97ae7d || git cherry-pick --abort || true

  # --- Conversion fixes ---

  # Remove layout-based canonical URL guard (PR #2833, fix/canonical-url-version-check)
  # https://github.com/quarkusio/quarkusio.github.io/pull/2833
  # replace_regex is a no-op on non-versioned URLs, so the if/else was unnecessary.
  # Also fixes Roq migration: page.data.layout is null for collection-inherited layouts
  # (https://github.com/quarkiverse/quarkus-roq/issues/1080).
  git cherry-pick 0448aaa0da || git cherry-pick --abort || true


)

fi

if [ ! -d "${project_dir}/_layouts" ]; then
    echo "ERROR: No _layouts/ found in ${project_dir} — project appears already converted."
    echo "Use --reset to start fresh from upstream/main."
    exit 1
fi


# Note: Previously deleted .yaml/.yml files from _versions, but the only YAML files
# that exist are telemetry-examples.yaml, which are content pages rendered by Roq.
# No deletion needed.

# Delete Jekyll docker-compose files (Jekyll-specific, not handled by converter)
rm -f ${project_dir}/docker-compose.yml ${project_dir}/docker-compose_with_guides.yml

# Rewrite serve scripts from Jekyll to Roq with Quarkus profiles
# serve.sh: full site (dev profile is automatic in quarkus:dev)
cat > ${project_dir}/serve.sh << 'SERVE'
#!/bin/sh
mvn quarkus:dev "$@"
SERVE

# serve-noguides.sh: no guides (fast iteration on non-guide pages)
cat > ${project_dir}/serve-noguides.sh << 'SERVE'
#!/bin/sh
echo "WARNING: Serving site with no guides. It is fast though!"
QUARKUS_PROFILE=noguides mvn quarkus:dev "$@"
SERVE

# serve-only-latest-guides.sh: only latest guides (skip old versions)
cat > ${project_dir}/serve-only-latest-guides.sh << 'SERVE'
#!/bin/bash
SCRIPTDIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
pushd "${SCRIPTDIR}"
echo "WARNING: Serving site with only the latest guides (latest and main)"
QUARKUS_PROFILE=only-latest-guides mvn quarkus:dev "$@"
popd
SERVE
chmod +x ${project_dir}/serve.sh ${project_dir}/serve-noguides.sh ${project_dir}/serve-only-latest-guides.sh

# Extensions layouts reference a cdi:extensions bean from deleted YAML data
# TODO is this still needed?
rm -f ${project_dir}/_layouts/extensions.html ${project_dir}/_layouts/extensions_old.html

# Delete Jekyll includes too complex for auto-conversion (allejo/jekyll-toc: pure-Liquid
# TOC generator using capture-concatenation, continue, slice, times, minus, etc.)
# TODO fix this
rm -f ${project_dir}/_includes/templates/toc.html

# Delete plugins that are already handled by the converter (filters/config) or need
# manual migration (asciidoctor extensions). Keep only cname.rb and copy-search-wc.rb.
rm -f ${project_dir}/_plugins/asciidoctor-extension.rb
rm -f ${project_dir}/_plugins/regex_filter.rb
rm -f ${project_dir}/_plugins/strings.rb

# TODO: If guides had their own dedicated directory structure (guides/guide-name/index.adoc),
# this static asset handling wouldn't be needed. Consider moving this to a dedicated guides
# ingest script when/if guides are separated from the main site content.
#
# Move guide static assets to assets/ subdirectories to keep them separate per version.
# Guides come from the Quarkus main repo and are versioned - different versions may have
# the same filename but different content. Creating an assets/ subdir at each guides level
# (guides/assets/, versions/3.2/guides/assets/, etc.) preserves version separation and
# keeps guide assets isolated from main site content.
echo "Organizing guide static assets into assets/ subdirectories..."
for guides_dir in ${project_dir}/_guides ${project_dir}/_versions/*/guides; do
    if [ ! -d "${guides_dir}" ]; then
        continue
    fi

    # Find static files in this guides directory
    find "${guides_dir}" -maxdepth 1 -type f \( \
        -name "*.py" -o \
        -name "*.sh" -o \
        -name "*.zip" -o \
        -name "*.tar.gz" -o \
        -name "*.jar" \
    \) | while read -r static_file; do
        # Create assets/ subdirectory
        assets_dir="${guides_dir}/assets"
        mkdir -p "${assets_dir}"

        # Move the file
        filename=$(basename "${static_file}")
        mv "${static_file}" "${assets_dir}/${filename}"
        echo "  Moved: ${static_file#${project_dir}/} -> ${assets_dir#${project_dir}/}/${filename}"

        # Create index.html if it doesn't exist to make assets/ servable
        if [ ! -f "${assets_dir}/index.html" ]; then
            # Determine the URL path for this assets directory
            # Extract path like "guides" or "versions/3.2/guides"
            rel_path=$(echo "${guides_dir}" | sed "s|${project_dir}/_||" | sed 's|^_||')
            printf '%s\n' '---' "link: /${rel_path}/assets/" '---' '<html><body></body></html>' > "${assets_dir}/index.html"
        fi
    done

    # Update AsciiDoc links in this guides directory to point to assets/ subdirectory
    if [ -d "${guides_dir}/assets" ]; then
        find "${guides_dir}" -maxdepth 1 -type f \( -name "*.adoc" -o -name "*.asciidoc" \) | while read -r doc_file; do
            # Fix links to static files - use ../assets/ relative path
            #
            # Why ../assets/ and not assets/?
            # - File path: content/guides/foo.adoc (flat structure)
            # - Render URL: /guides/foo/ (directory-style URL, note trailing slash)
            # - Asset path: content/guides/assets/file.py
            # - Asset URL: /guides/assets/file.py
            #
            # AsciiDoc link: macro resolves relative to the page's URL location:
            # - link:assets/file.py → /guides/foo/ + assets/file.py = /guides/foo/assets/file.py (404)
            # - link:../assets/file.py → /guides/foo/ + ../assets/file.py = /guides/assets/file.py (correct)
            #
            # This works for all nesting depths:
            # - /guides/foo/ → ../assets/ = /guides/assets/
            # - /versions/3.2/guides/foo/ → ../assets/ = /versions/3.2/guides/assets/
            #
            # Do each extension separately to avoid nested parentheses issues with BSD sed
            sed_inplace -E 's|link:([a-zA-Z0-9_-]+\.py)|link:../assets/\1|g' "${doc_file}"
            sed_inplace -E 's|link:([a-zA-Z0-9_-]+\.sh)|link:../assets/\1|g' "${doc_file}"
            sed_inplace -E 's|link:([a-zA-Z0-9_-]+\.zip)|link:../assets/\1|g' "${doc_file}"
            sed_inplace -E 's|link:([a-zA-Z0-9_-]+\.jar)|link:../assets/\1|g' "${doc_file}"
            sed_inplace -E 's|link:([a-zA-Z0-9_-]+\.tar\.gz)|link:../assets/\1|g' "${doc_file}"
        done
    fi
done

# Escape literal {| and |} sequences in qute-reference files BEFORE conversion.
# These files document Qute's escape syntax, so they contain literal {| and |}
# in backticks that would otherwise prematurely close Roq's {| |} escape wrapper.
echo "Escaping literal {| |} in qute-reference guides..."
find ${project_dir}/_guides ${project_dir}/_versions -type f -name "*qute-reference.adoc" -print0 2>/dev/null | while IFS= read -r -d '' file; do
    sed_inplace 's/|}/|\\}/g' "$file"
    sed_inplace 's/{|/\\{|/g' "$file"
    echo "  Escaped: $file"
done

### Convert!

${tools_dir}/roq-it-jekyll ${project_dir}

# TEMPORARY WORKAROUND for Roq 2.1.5 quote escaping bug in aliases plugin
# Issue: https://github.com/quarkiverse/quarkus-roq/pull/1078
# The /publications redirect gets merged as an alias into newsletter.md, and when
# Roq renders the alias redirect page with an absolute URL (because site.url is set),
# the meta refresh tag has unbalanced quotes: content="0; url="https://..."
# This causes RedirectTest.publicationsRedirectsToNewsletter to fail.
#
# Workaround: Remove the /publications alias from newsletter.md and create a static
# redirect page instead, bypassing the aliases plugin entirely.
#
# TODO: Remove this workaround once https://github.com/quarkiverse/quarkus-roq/pull/1078
# is merged and released (expected in Roq 2.1.6 or later).
if [ -f "${project_dir}/content/newsletter.md" ]; then
    sed_inplace '/^  - \/publications$/d' "${project_dir}/content/newsletter.md"
    echo "WORKAROUND: Removed /publications alias from newsletter.md (Roq 2.1.5 quote bug)"
fi
# Create a static redirect page that bypasses the aliases plugin
mkdir -p "${project_dir}/public/publications"
cat > "${project_dir}/public/publications/index.html" << 'REDIRECT'
<!doctype html>
<html>
<head>
<meta http-equiv="refresh" content="0; url=/newsletter/">
<link rel="canonical" href="/newsletter/" />
</head>
</html>
REDIRECT
echo "WORKAROUND: Created static /publications/ redirect page"


# Move data/ back to _data/ and configure Roq to find it there
# This makes the migration less disruptive, and less likely to have merge conflicts with what the working group sync does
mv ${project_dir}/data ${project_dir}/_data
echo 'quarkus.roq.data.dir=_data' >> ${project_dir}/config/application.properties

# With all the guides, the roq plugin is a bit slow
echo 'quarkus.roq.generator.timeout=600' >> ${project_dir}/config/application.properties


# Add e2e profile to pom.xml (excludes e2e-tagged tests by default, profile enables them)
sed_inplace '/<artifactId>maven-surefire-plugin<\/artifactId>/{
N
N
s|<configuration>|<configuration>\
                    <excludedGroups>e2e</excludedGroups>|
}' ${project_dir}/pom.xml

sed_inplace '/<profiles>/a\
\        <profile>\
\            <id>e2e</id>\
\            <build>\
\                <plugins>\
\                    <plugin>\
\                        <artifactId>maven-surefire-plugin</artifactId>\
\                        <configuration>\
\                            <groups>e2e</groups>\
\                            <excludedGroups combine.self="override"/>\
\                        </configuration>\
\                    </plugin>\
\                </plugins>\
\            </build>\
\        </profile>
' ${project_dir}/pom.xml


if [ "${RUN_TESTS}" = "true" ]; then
    # SSG build: render all pages like CI does (quarkus:run with BATCH=true)
    # This catches errors that dev mode misses since it renders every route.
    echo "=== SSG build (quarkus:run) ==="
    (cd ${project_dir} && QUARKUS_ROQ_GENERATOR_BATCH=true QUARKUS_PROFILE=only-latest-guides mvn -B package quarkus:run -DskipTests \
        > ${tmp_dir}/roq-ssg.log 2>&1) || true
    SSG_ERRORS=$(grep -c 'ERROR' ${tmp_dir}/roq-ssg.log 2>/dev/null || echo 0)
    echo "SSG build complete — ${SSG_ERRORS} error lines (see ${tmp_dir}/roq-ssg.log)"
    grep 'ERROR' ${tmp_dir}/roq-ssg.log | head -10

    # Install Playwright browsers
    # Try with system deps first (works on Debian/Ubuntu), fall back to browser-only on other systems
    (cd ${project_dir} && mvn exec:java -e -Dexec.classpathScope=test \
        -Dexec.mainClass=com.microsoft.playwright.CLI \
        -Dexec.args="install --with-deps chromium") || \
    (cd ${project_dir} && mvn exec:java -e -Dexec.classpathScope=test \
        -Dexec.mainClass=com.microsoft.playwright.CLI \
        -Dexec.args="install chromium")

    # Kill anything already on port 8090 — be emphatic to avoid stale servers
    # from prior runs returning cached error pages
    lsof -ti:8090 | xargs kill -9 2>/dev/null || true
    sleep 2
    lsof -ti:8090 | xargs kill -9 2>/dev/null || true
    sleep 1

    # Start dev server in background on port 8090
    (cd ${project_dir} && mvn quarkus:dev -Dquarkus.http.port=8090 \
        > ${tmp_dir}/roq-server.log 2>&1) &
    SERVER_PID=$!
    # Wait for the server to respond (200 or 500 — both mean it's up)
    timeout 300 bash -c 'until curl -s -o /dev/null -w "%{http_code}" http://localhost:8090 2>/dev/null | grep -qE "200|500"; do sleep 2; done'
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8090 2>/dev/null)
    echo "Dev server started (PID $SERVER_PID, HTTP $HTTP_CODE)"
    if [ "$HTTP_CODE" = "500" ]; then
        echo "ERROR: Server returned 500 — Qute template error detected"
        curl -s http://localhost:8090 | grep -oP 'Parser error[^<]*|Found \d+ Qute problems' | head -5
    fi

    # Run tests against the dev server
    # Use a separate Maven invocation with -pl to avoid stomping the dev server's target/
    # Skip validation on systems where deps aren't installed (fallback from install step above)
    (cd ${project_dir} && PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 mvn -B surefire:test -Dtest.url=http://localhost:8090) || true

    kill $SERVER_PID 2>/dev/null
    wait $SERVER_PID 2>/dev/null
fi

if [ "$COMMIT_MODE" = "true" ]; then
(
    cd ${project_dir}

    # Check if there are changes to commit
    if git diff --quiet && git diff --cached --quiet && [ -z "$(git status --porcelain)" ]; then
        echo "No changes to commit"
    else
        echo "Committing migration changes..."

        # Add all changes
        git add -A

        # Create commit
        git commit -m "$(cat <<'EOF'
Migrate from Jekyll to Roq

Automated migration using roq-it-jekyll and haq-it scripts:
- Converted Liquid templates to Qute
- Converted Jekyll config to Roq
- Converted frontmatter (permalinks → aliases, pagination → paginate)
- Converted AsciiDoc link: to xref: for cross-references
- Moved directories (_guides → content/guides, etc.)
- Updated asset paths and static file handling
- Copied AsciidoctorJ extensions
- Applied cherry-picked fixes from unmerged branches

EOF
)"

        echo "✓ Migration committed"


# TODO temporary workaround pending https://github.com/quarkusio/quarkus/issues/55438
git cherry-pick 446c50d009f82da9ae86cef16a74e3d4a659fb5e || git cherry-pick --abort || true
git cherry-pick bf92c65aea457acb0102799f924dffe3bcf44488 || git cherry-pick --abort || true

        if [ "$PUSH_MODE" = "true" ]; then
            CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
            echo "Force pushing to origin/$CURRENT_BRANCH..."
            git push --force origin $CURRENT_BRANCH
            echo "✓ Pushed to origin/$CURRENT_BRANCH"
        fi
    fi
)
fi
