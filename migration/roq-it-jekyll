#! /bin/bash

set -x

# TODO this only works in a new shell, do a source?
# TODO or just the mvn commands
# or a pre-script?
# curl -Ls https://sh.jbang.dev | bash -s - trust add https://repo1.maven.org/maven2/io/quarkiverse/roq/
# curl -Ls https://sh.jbang.dev | bash -s - app install --fresh --force roq@quarkiverse/quarkus-roq

export project_dir=$1
export tools_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export tmp_dir=~/tmp

## Ensure a clean state in the starting project

# Clear directories with roq names
rm -rf ${project_dir}/content/
rm -rf ${project_dir}/data/
rm -rf ${project_dir}/templates/

rm -f ${project_dir}/application.properties

mkdir -p ${tmp_dir}
export roq_skeleton_dir=${tmp_dir}/quarkusio-roq-skeleton

## Make a donor roq project
# TODO this could be done with a direct call to RoqProjectCreator, but I am not sure how much it gives us
rm -rf ${roq_skeleton_dir}
(
cd ${tmp_dir}
roq create quarkusio-roq-skeleton
)

# Remove scaffolded files that we have already
# Better idea - copy what we need

mv ${roq_skeleton_dir}/pom.xml ${project_dir}
mv ${roq_skeleton_dir}/config ${project_dir}

# Roq content lives in content
mkdir -p ${project_dir}/content
mv ${project_dir}/*md ${project_dir}/content/

mkdir -p ${project_dir}/templates

# clear target directories

# Adjust folder names and locations
mv ${project_dir}/_posts ${project_dir}/content/posts
mv ${project_dir}/_data ${project_dir}/data
# done with a liquid conversion step mv _layouts templates/layouts

## Assets maps to public in roq
mv ${project_dir}/assets ${project_dir}/public

mv ${project_dir}/_site/index.html ${project_dir}

# TODO can't be a good idea
mv ${roq_skeleton_dir}/data/menu.yml ${project_dir}/data
# TODO same

# TODO check jbang is installed
# Convert Liquid to Qute; this has the side effect of renaming directories to adjust the structure
mkdir ${project_dir}/includes
jbang ${tools_dir}/LiquidToQuteConverter.java ${project_dir}/_includes ${project_dir}/includes
jbang ${tools_dir}/LiquidToQuteConverter.java ${project_dir}/_layouts ${project_dir}/templates/layouts

# TODO need to be more selective here, should not be needed, what is in here?
# mv ${roq_skeleton_dir}/content ${project_dir}

# Enable the alternative expression syntax to reduce overhead of escaping braces
echo quarkus.qute.alt-expr-syntax=true >> ${project_dir}/config/application.properties
echo "site.date-format=yyyy-MM-dd['T'HH:mm:ss][X]" >> ${project_dir}/config/application.properties
# TODO need to add name and simple-name - global config?

# TODO maven should work?
(
    cd ${project_dir}
    roq dev
)